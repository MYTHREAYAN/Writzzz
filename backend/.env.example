# Server
NODE_ENV=development
PORT=5000

# MongoDB — local default; Atlas URI also works
MONGODB_URI=mongodb://127.0.0.1:27017/trio_assignment

# JWT — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# HTTP-only auth cookie
COOKIE_NAME=trio_auth_token
COOKIE_MAX_AGE_MS=604800000

# Frontend origin (CORS + password-reset links)
CLIENT_URL=http://localhost:5173

# Password reset token lifetime
RESET_TOKEN_EXPIRY_MINUTES=30

# Optional SMTP. If empty, reset links are logged to the server console.
# In development the API also returns resetUrl so you can test without email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TRIO ASSIGNMENT <noreply@trioassignment.local>"
